# Model backend: "ollama" (local, default) or "claude" (Anthropic API)
MEDIGUIDE_TEXT_BACKEND=ollama
MEDIGUIDE_VISION_BACKEND=ollama

# Ollama server + local model names (pull with `ollama pull <name>` first)
OLLAMA_HOST=http://localhost:11434
MEDIGUIDE_OLLAMA_TEXT_MODEL=llama3.1
MEDIGUIDE_OLLAMA_VISION_MODEL=llava

# Only needed if a backend above is set to "claude"
ANTHROPIC_API_KEY=
MEDIGUIDE_CLAUDE_TEXT_MODEL=claude-opus-5
MEDIGUIDE_CLAUDE_VISION_MODEL=claude-opus-5

# Speech
MEDIGUIDE_WHISPER_MODEL=base

# Text-to-speech via Piper (free, offline — https://github.com/rhasspy/piper).
# Download a voice (.onnx + .onnx.json) and point this at the .onnx file.
MEDIGUIDE_PIPER_MODEL_PATH=

# RAG
MEDIGUIDE_EMBEDDING_MODEL=all-MiniLM-L6-v2
MEDIGUIDE_KNOWLEDGE_DIR=data/knowledge
MEDIGUIDE_VECTOR_STORE_DIR=data/vector_store
MEDIGUIDE_OUTPUT_DIR=outputs

# Gradio server
MEDIGUIDE_SERVER_NAME=127.0.0.1
MEDIGUIDE_SERVER_PORT=7860
